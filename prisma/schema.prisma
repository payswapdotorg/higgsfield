generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String?
  planType    String   @default("free")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folders     Folder[]
  generations Generation[]
  creditPools CreditPool[]
  ledger      CreditLedger[]
  freeGens    FreeGensGrant[]
}

/// "Project" in the product UI is a folder of generations (HF-W2 §3.1 — rename semantics OK).
model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations Generation[]

  @@unique([userId, name])
  @@index([userId])
}

model Generation {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  modelVersion String // MODEL_CATALOG slug, e.g. "nano-banana-2"
  jobSetType   String // e.g. "nano_banana_2"
  kind         String // "image" | "video"
  prompt       String
  aspectRatio  String
  resolution   String
  width        Int
  height       Int
  batchSize    Int
  inputImages  String    @default("[]") // JSON array of strings (SQLite has no list columns)
  workspaceId  String?
  status       String    @default("queued") // queued | processing | done | failed
  seed         Int
  cost         Int
  creditSpend  String    @default("[]") // JSON [{pool, amount}] — how the cost was funded
  assetUrl     String?
  assetKind    String?
  error        String?
  notices      String    @default("[]") // JSON [{variant, badge:{label, tooltip}}]
  publishedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  completedAt DateTime?

  publications FeedPublication[]
  ledger       CreditLedger[]

  @@index([userId, status])
  @@index([folderId])
  @@index([status, createdAt])
}

/// Mirrors the §1c per-model credit pools: kind is "wallet" | "daily" | "model:<jobSetType>".
model CreditPool {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  balance   Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, kind])
  @@index([userId])
}

model CreditLedger {
  id           String      @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolKind     String
  poolId       String?
  jobId        String?
  job         Generation? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  delta        Int
  balanceAfter Int
  reason       String
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
}

/// §1c touring free-generations reward (per job_set_type).
model FreeGensGrant {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  used       Int       @default(0)
  jobSetType String
  claimed    Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, jobSetType])
}

/// Community read-model (HF-W2 §3.1).
model FeedPublication {
  id             String      @id @default(cuid())
  generationId   String      @unique
  generation     Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  authorUsername String
  thumbnailUrl   String
  views          Int         @default(0)
  likes          Int         @default(0)
  publishedAt    DateTime    @default(now())
}

/// §1e contests items (field names verbatim, values are seeded demo data).
model Contest {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  startAt      DateTime
  endAt        DateTime
  status       String   @default("open")
  previewImage String?
  previewVideo String?
  logoUrl      String?
  redirectUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
