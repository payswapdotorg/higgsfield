// HF Studio — wave 1 data layer.
// Clean-room schema mirroring the captured Higgsfield studio evidence
// (folders/projects, generations, contests, credit ledger, users).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  username    String?   @unique
  image       String?
  credits     Int       @default(0)
  planTier    String    @default("free") // free | starter | plus
  quizAnswers String? // JSON string of onboarding answers
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String       @id @default(cuid())
  name        String
  accessMode  String       @default("private") // private | public
  surface     String       @default("cinematic_studio")
  workspaceId String?
  pinnedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]
}

model Generation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  mode            String   // image | video
  prompt          String
  model           String
  resolution      String
  aspectRatio     String
  durationSeconds Int?
  motion          Boolean  @default(true)
  steps           Int      @default(1)
  status          String   @default("queued") // queued | processing | done | failed
  creditCost      Int
  resultUrl       String?
  error           String?
  createdAt       DateTime @default(now())
}

model Contest {
  id           String    @id
  slug         String    @unique
  title        String
  description  String
  startAt      DateTime
  endAt        DateTime
  status       String // open | upcoming | closed
  previewImage String?
  previewVideo String?
}

model CreditTxn {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}
