generator client {
  provider = "prisma-client-js"
}

datasource db {
  // HF-W6: provider moved sqlite → postgresql (Neon) for the Vercel-serverless port.
  // Infrastructure-only change — every column type is PG-compatible as-is. The
  // JSON-in-String columns (badges, inputImages, creditSpend, winner,
  // someContestants, judges, unlimitedSettings, notices) are deliberately NOT
  // converted to Prisma `Json`/jsonb: the JSON-in-a-TEXT-column convention
  // predates this port (SQLite has no list columns) and is kept to minimize the
  // diff and preserve behavior byte-for-byte.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String?
  planType    String   @default("free")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// ── HF-W5 profile model (evidence: evidence/rea-2026-10-17/api-bodies-digest.json →
  /// `profile` — the verbatim /fnf/user/profile body captured on the live operator
  /// account). Field names map 1:1 onto the captured snake_case keys; values for
  /// un-seeded users stay null/0/false exactly like the captured fresh account.
  /// NOTE: the captured body carries exactly SIX social handles (instagram/twitter/
  /// youtube/tiktok/discord/linkedin) — the dispatch text said "8 social handles",
  /// but the evidence is the contract, so six is what is modeled (disclosed in
  /// docs/wave-5-worker-worklog.md).
  avatarUrl            String?  // avatar_url (captured: cloudfront webp URL)
  backgroundImageUrl   String?  // background_image_url (captured: null)
  bio                  String?  // bio (captured: null)
  headline             String?  // headline (captured: null)
  instagramHandle      String?  // instagram_handle
  twitterHandle        String?  // twitter_handle
  youtubeHandle        String?  // youtube_handle
  tiktokHandle         String?  // tiktok_handle
  discordHandle        String?  // discord_handle
  linkedinHandle       String?  // linkedin_handle
  showFullName         Boolean  @default(false) // show_full_name (captured: false)
  fullName             String?  // full_name (captured: "yaslen Catty")
  location             String?  // location (captured: null)
  badge                String?  // badge (captured: null — singular)
  badges               String   @default("[]") // badges — JSON array (captured: []; SQLite has no list columns)
  totalProjectsViews   Int      @default(0) // total_projects_views (captured: 0)
  totalProjectsLikes   Int      @default(0) // total_projects_likes (captured: 0)

  folders     Folder[]
  generations Generation[]
  creditPools CreditPool[]
  ledger      CreditLedger[]
  freeGens    FreeGensGrant[]
  settings    UserSettings?
  characters  Character[]
}

/// HF-W7 — AI Influencer characters (/ai-influencer-studio persistence).
/// `spec` is the 19-setting option spec (src/lib/influencer-options.ts) stored as a
/// JSON string — the repo's JSON-in-a-TEXT-column convention (same as
/// Generation.inputImages / creditSpend; see the datasource header note).
/// `referenceImage` is the optional uploaded face reference (data:image/… URI).
/// No asset columns: portrait/full-body assets resolve through the linked
/// Generation rows (characterId) so the job pipeline stays the single asset truth.
model Character {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  spec           String
  referenceImage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/// HF-W5 — the /fnf/user/settings consent body, verbatim key set (evidence:
/// evidence/rea-2026-10-17/api-bodies-digest.json → `settings`, cross-checked against
/// net-capture-with-auth-headers.jsonl: /fnf/user/settings is GET 200 with reqBody
/// null on every captured row → read-only surface, mutations are NOT cloned).
/// Defaults mirror the captured values exactly (consents false/null, has_image_auto
/// true — a state flag, not a consent). unlimitedSettings is the captured
/// `unlimited_settings` object stored as a JSON string (captured: null).
model UserSettings {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaConsent            Boolean   @default(false) // media_consent
  mediaConsentedAt        DateTime? // media_consented_at
  audioConsent            Boolean?  // audio_consent (captured: null — tri-state)
  audioConsentedAt        DateTime? // audio_consented_at
  unlimitedSettings       String?   // unlimited_settings (JSON; captured: null)
  hasImageAuto            Boolean   @default(true) // has_image_auto
  characterSheetsConsent  Boolean   @default(false) // character_sheets_consent
  characterSheetsConsentedAt DateTime? // character_sheets_consented_at
  aiInfluencerConsent     Boolean   @default(false) // ai_influencer_consent
  aiInfluencerConsentedAt DateTime? // ai_influencer_consented_at
  supercomputerLlmConsent Boolean   @default(false) // supercomputer_llm_consent
  supercomputerLlmConsentedAt DateTime? // supercomputer_llm_consented_at

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// "Project" in the product UI is a folder of generations (HF-W2 §3.1 — rename semantics OK).
model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations Generation[]

  @@unique([userId, name])
  @@index([userId])
}

model Generation {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  modelVersion String // MODEL_CATALOG slug, e.g. "nano-banana-2"
  jobSetType   String // e.g. "nano_banana_2"
  kind         String // "image" | "video"
  prompt       String
  aspectRatio  String
  resolution   String
  width        Int
  height       Int
  batchSize    Int
  inputImages  String    @default("[]") // JSON array of strings (SQLite has no list columns)
  workspaceId  String?
  status       String    @default("queued") // queued | processing | done | failed
  /// Wave-4 H2: attempt counter for the single automatic retry (maxAttempts = 2 —
  /// the server-side mirror of the client-side one-transparent-retry pattern, §1d/§1a:
  /// 401 → one retry after refresh; 429/403 challenge → toast + one retry). 1 = first
  /// attempt; a retryable failure re-enqueues the job once with attempt = 2.
  attempt      Int       @default(1)
  seed         Int
  /// HF-W7: Int → Float widening (see the credit-amounts block comment below) — the
  /// AI Influencer evidence credit cost is fractional (1.125 credits per generate,
  /// evidence node 2252), so per-job costs may be fractional (0.5625).
  cost         Float
  /// HF-W7 (additive): links influencer jobs (influencer_portrait / influencer_fullbody /
  /// influencer_motion jobSetTypes) to their Character. Nullable + no FK on purpose —
  /// hard-deleting a Character leaves the generations in place with a dangling id
  /// (jobToJson is unaffected; asset resolution treats the dangling id as "no character").
  characterId  String?
  creditSpend  String    @default("[]") // JSON [{pool, amount}] — how the cost was funded
  assetUrl     String?
  assetKind    String?
  error        String?
  notices      String    @default("[]") // JSON [{variant, badge:{label, tooltip}}]
  publishedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  completedAt DateTime?

  publications FeedPublication[]
  ledger       CreditLedger[]

  @@index([userId, status])
  @@index([folderId])
  @@index([status, createdAt])
  @@index([characterId])
}

/// HF-W7 — CREDIT AMOUNT COLUMNS WIDENED Int → Float (DISCLOSED DEVIATION).
/// The wave-7 AI Influencer surface carries the captured evidence credit cost
/// 1.125 credits per generate (evidence node 2252 '1.125 credits'), split as two
/// 0.5625-cost jobs — values the previous Int columns cannot represent (empirically
/// verified: Prisma silently truncates 0.5625 to 0 on an Int field, corrupting the
/// burn). Int → Float is a LOSSLESS, NON-DESTRUCTIVE widening: every existing value
/// is integral and stays bit-exact in float64, so all existing integer assertions
/// (wallet 0/97, ledger -2, grant used 5 …) hold unchanged. No table or column is
/// dropped; `prisma db push` applies it as ALTER COLUMN TYPE on four small tables.
/// Widened columns: Generation.cost, CreditPool.balance, CreditLedger.delta,
/// CreditLedger.balanceAfter, FreeGensGrant.used. (FreeGensGrant.amount stays Int —
/// grants are only ever created with integral amounts.)
/// Mirrors the live product, whose credit costs are demonstrably fractional.

/// Mirrors the §1c per-model credit pools: kind is "wallet" | "daily" | "model:<jobSetType>".
model CreditPool {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  /// HF-W7: Int → Float widening — see the credit-amounts block comment at Generation.
  balance   Float     @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, kind])
  @@index([userId])
}

model CreditLedger {
  id           String      @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolKind     String
  poolId       String?
  jobId        String?
  job         Generation? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// HF-W7: Int → Float widening — see the credit-amounts block comment at Generation.
  delta        Float
  balanceAfter Float
  reason       String
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
}

/// §1c touring free-generations reward (per job_set_type).
model FreeGensGrant {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  /// HF-W7: Int → Float widening — see the credit-amounts block comment at Generation
  /// (a fractional influencer spend can consume a fractional slice of a grant).
  used       Float     @default(0)
  jobSetType String
  claimed    Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, jobSetType])
}

/// Community read-model (HF-W2 §3.1).
model FeedPublication {
  id             String      @id @default(cuid())
  generationId   String      @unique
  generation     Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  authorUsername String
  thumbnailUrl   String
  views          Int         @default(0)
  likes          Int         @default(0)
  publishedAt    DateTime    @default(now())
}

/// §1e contests items (field names verbatim, values are seeded demo data).
/// HF-W3C extension — the wave-2 model lacked fields the live contests body
/// carries (evidence/rea-2026-10-17/api-bodies-digest.json → contests items
/// keys: prize_pool, submissions_count, winner, some_contestants, judges,
/// is_trending). SQLite has no list/object columns, so winner / some_contestants
/// / judges are stored as JSON strings (the same convention as
/// Generation.inputImages / creditSpend).
model Contest {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  startAt         DateTime
  endAt           DateTime
  status          String   @default("open")
  previewImage    String?
  previewVideo    String?
  logoUrl         String?
  redirectUrl     String?
  /// digest key prize_pool (USD, e.g. 1000000).
  prizePool       Int?
  /// digest key submissions_count.
  submissionsCount Int     @default(0)
  /// digest key winner — JSON {id, username, avatar_url} | null.
  winner          String?
  /// digest key some_contestants — JSON [{id, username, avatar_url}].
  someContestants String   @default("[]")
  /// digest key judges — JSON [{user_id, display_name, description, avatar_url, background_url, external_link}].
  judges          String   @default("[]")
  /// digest key is_trending.
  isTrending      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
